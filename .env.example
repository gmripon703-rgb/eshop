# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled)
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# XCART_API_BASE_URL: Backend REST API endpoint for production or staging server
# Example: https://api.xcart-store.com/v1/
XCART_API_BASE_URL=https://api.xcart-store.com/v1/

# GOOGLE_CLIENT_ID: Official Google OAuth 2.0 Web Client ID for customer authentication
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# FACEBOOK_APP_ID: Meta / Facebook Developer App ID for social authentication
FACEBOOK_APP_ID=your_facebook_app_id_here

# PUSH_NOTIFICATIONS_SERVER_KEY: Firebase Cloud Messaging / Notification service key
FCM_SENDER_ID=your_fcm_sender_id_here

